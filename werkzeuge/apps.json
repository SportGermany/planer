{
  "_hinweis": "Apps aus diesem Repo (werkzeuge/PLAN-APPS.md). Planer: Version aus build.py, Release v<ver>. Andere: Release <app>-v<ver>; dirs = Ordner, die in die APK kommen (Dateien im Hauptordner immer).",
  "planer": {
    "id": "de.sportgermany.planer",
    "name": "Planer",
    "start": "app/",
    "ohne": [
      "training",
      "schule",
      "bibel",
      "wissen"
    ]
  },
  "bibel": {
    "id": "de.sportgermany.bibel",
    "name": "Bibel",
    "start": "bibel/",
    "dirs": [
      "bibel",
      "sg"
    ],
    "ver": "2.0.0",
    "probe": {
      "keys": {
        "zweiminutenbibel_v2": "{\"streak\":7}"
      },
      "ziel": "bibliothek",
      "check": "document.getElementById('view-bibliothek').classList.contains('active')"
    },
    "farbe": "#6B4A3A",
    "symbol": [
      "M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z",
      "M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5"
    ]
  },
  "schule": {
    "id": "de.sportgermany.schule",
    "name": "Schule",
    "start": "schule/",
    "dirs": [
      "schule",
      "sg"
    ],
    "ver": "3.0.0",
    "probe": {
      "keys": {
        "schulplaner-lokal-v1": "{\"homeMore\":true}"
      },
      "ziel": "plan",
      "check": "document.querySelector('.tab[data-v=plan]').classList.contains('on')",
      "open": "openSettings()",
      "idb": {
        "lernplan-dateien/files": [
          [
            "doc1",
            {
              "__blob": "data:application/pdf;base64,JVBERi0xLjQgdGVzdA==",
              "type": "application/pdf",
              "name": "Arbeitsblatt.pdf"
            }
          ]
        ]
      },
      "stores": {
        "lernplan-dateien": [
          "files",
          "inbox"
        ]
      }
    },
    "net": [
      "openholidaysapi.org"
    ],
    "farbe": "#2B5FD9",
    "symbol": [
      "M2.5 9l9.5-5 9.5 5-9.5 5z",
      "M6.5 11.2v4.8c0 1.5 2.5 3 5.5 3s5.5-1.5 5.5-3v-4.8"
    ]
  },
  "training": {
    "id": "de.sportgermany.training",
    "name": "Training",
    "start": "training/",
    "dirs": [
      "training",
      "wissen",
      "sg"
    ],
    "ver": "3.0.0",
    "probe": {
      "keys": {
        "wk_onboarded": "1",
        "pulsplan.v1": "{\"sessions\":[]}"
      },
      "ziel": "kraft",
      "check": "document.getElementById('s-lauf').classList.contains('active') && document.getElementById('s-lauf').getAttribute('data-part') === 'kraft'",
      "idb": {
        "bahnplan/img": [
          [
            "map-test",
            {
              "__blob": "data:image/png;base64,iVBORw0KGgo=",
              "type": "image/png",
              "name": "plan.png"
            }
          ]
        ]
      },
      "stores": {
        "bahnplan": [
          "img"
        ]
      },
      "open": "location.hash = 'einst'"
    },
    "farbe": "#2F7D57",
    "symbol": [
      "M12.5 4.5a2 2 0 1 0 4 0a2 2 0 1 0 -4 0",
      "M8 21l3-6 3 2 1 4M10.5 15l1-5 4 2 3-1M8 10l3-2"
    ]
  }
}
