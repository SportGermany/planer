{
  "_hinweis": "Apps aus diesem Repo (werkzeuge/PLAN-APPS.md). Planer: Version aus build.py, Release v<ver>. Andere: Release <app>-v<ver>; dirs = Ordner, die in die APK kommen (Dateien im Hauptordner immer).",
  "planer": {
    "id": "de.sportgermany.planer",
    "name": "Planer",
    "start": "app/"
  },
  "bibel": {
    "id": "de.sportgermany.bibel",
    "name": "Bibel",
    "start": "bibel/",
    "dirs": [
      "bibel",
      "sg"
    ],
    "ver": "1.0.0",
    "probe": {
      "keys": {
        "zweiminutenbibel_v2": "{\"streak\":7}"
      },
      "ziel": "bibliothek",
      "check": "document.getElementById('view-bibliothek').classList.contains('active')"
    }
  },
  "schule": {
    "id": "de.sportgermany.schule",
    "name": "Schule",
    "start": "schule/",
    "dirs": [
      "schule",
      "sg"
    ],
    "ver": "1.0.0",
    "probe": {
      "keys": {
        "schulplaner-lokal-v1": "{\"homeMore\":true}"
      },
      "ziel": "plan",
      "check": "document.querySelector('.tab[data-v=plan]').classList.contains('on')",
      "open": "openSettings()",
      "idb": {
        "lernplan-dateien/files": [
          [
            "doc1",
            {
              "__blob": "data:application/pdf;base64,JVBERi0xLjQgdGVzdA==",
              "type": "application/pdf",
              "name": "Arbeitsblatt.pdf"
            }
          ]
        ]
      },
      "stores": {
        "lernplan-dateien": [
          "files",
          "inbox"
        ]
      }
    },
    "net": [
      "openholidaysapi.org"
    ]
  }
}
